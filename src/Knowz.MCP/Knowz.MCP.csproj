<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- MCPEXP002: HttpServerTransportOptions.RunSessionHandler (Program.cs) is marked
         evaluation-only in ModelContextProtocol 2.x; it backs the per-session API-key store,
         so keep it and suppress the diagnostic until the SDK ships a stable session API. -->
    <NoWarn>$(NoWarn);MCPEXP002</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Matches the MCP ServerInfo version in Program.cs and the Sentry options.Release tag (assembly version). -->
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Knowz.MCP.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.11" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Sentry.AspNetCore" Version="6.10.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Knowz.Core\Knowz.Core.csproj" />
  </ItemGroup>

</Project>
