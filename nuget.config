<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="local-packages" />
  </packageSources>
  <!-- Dependency-confusion defense: pin first-party package prefixes to the
       'local' feed so a malicious upstream 'Knowz.*' on nuget.org can never be
       resolved. All other packages continue to resolve from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Knowz.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
